---
import Navbar from '../components/Navbar.astro';
import Main from '../components/sections/Main.astro';
import Proyectos from '../components/sections/Proyectos.astro';
import Layout from '../layouts/Layout.astro';
import Servicios from '../components/sections/Servicios.astro'
import WhatsappButton from '../components/WhatsappButton.astro'
import Contacto from '../components/sections/Contacto.astro';
import FormularioContacto from '../components/sections/FormularioContacto.astro';
import Footer from '../components/sections/Footer.astro';
import TransformacionesCards from '../components/sections/TransformacionesCards.astro';

---

<Layout
	title="González Obras | Construcción en Seco en San Pedro, Buenos Aires"
	description="González Obras: más de 8 años en construcción en seco. Wall panel, cielorrasos, PVC, steel frame, revestimientos y amoblamientos a medida en San Pedro, Buenos Aires. Atendemos CABA, provincia de Buenos Aires y Rosario."
>
	<Navbar />
	<Main />
	<Proyectos />
	<TransformacionesCards />
	<Servicios />
	<div class="relative md:flex md:mb-10 md:pb-5 px-5 md:px-20 xl:px-40 md:gap-10 lg:mb-10 lg:mt-0 pt-2 lg:pt-0">
		<Contacto />
		<FormularioContacto sectionClass="md:flex-1" />
	</div>
	<Footer />

	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "LocalBusiness",
