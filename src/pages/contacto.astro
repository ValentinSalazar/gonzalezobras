---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/sections/Footer.astro';
import FormularioContacto from '../components/sections/FormularioContacto.astro';
import TitleSection from '../components/TitleSection.astro';
import Instagram from '../components/icons/Instagram.astro';
import Facebook from '../components/icons/Facebook.astro';
import { Image } from 'astro:assets';
import heroImg from '../assets/projects/proyectos01.webp';
---

<Layout
    title="Contacto | González Obras - Pedí tu Presupuesto en San Pedro, Buenos Aires"
    description="Contactá a González Obras para tu proyecto de construcción en seco. Presupuestos sin cargo en San Pedro, Buenos Aires, CABA y Rosario. Respondemos en menos de 24 horas."
>
    <Navbar />
    <div class="relative h-80 overflow-hidden">
        <Image
            src={heroImg}
            alt="Contacto González Obras"
            width={1200}
            class="absolute inset-0 w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
        />
        <div class="absolute inset-0 bg-linear-to-b from-black via-black/90 to-black/60"></div>
        <div class="absolute top-32 left-0 right-0 z-10 px-5 md:px-20 xl:px-40">
            <span class="flex w-14 h-1 bg-first mb-2"></span>
            <TitleSection
                title="Contacto"
                color="secondary"
                subtitle="hablemos de tu proyecto"
                subtitle_color="white"
                mas_color="first"
                title_size="text-5xl"
            />
        </div>
    </div>

    <FormularioContacto sectionClass="px-5 md:px-32 xl:px-64" />

    <div class="bg-[#f9fafb] px-5 md:px-20 xl:px-40 py-14 border-t border-gray-200">

        <div class="mb-10 pb-8 border-b border-gray-200">
            <span class="flex w-14 h-1 bg-first mb-4"></span>
            <p class="font-bebas text-gray-900 text-3xl md:text-4xl leading-none">Respondemos en menos de 24 horas</p>
        </div>

        <div class="flex flex-col md:flex-row gap-12 md:gap-0 md:divide-x divide-gray-200">

            <div class="md:pr-12 flex flex-col gap-6 md:w-1/3">
                <p class="font-poppins text-gray-400 text-xs uppercase tracking-widest">Contacto directo</p>

                <a href="https://wa.me/3329335202?text=Hola%2C%20quiero%20consultar%20por%20un%20presupuesto" target="_blank" class="group">
                    <p class="font-poppins text-gray-400 text-xs uppercase tracking-widest mb-1">WhatsApp</p>
                    <p class="font-bebas text-gray-900 text-3xl leading-none group-hover:text-first transition">+54 3329 335202</p>
                </a>

                <a href="mailto:facundo@gonzalezobras.com" class="group">
                    <p class="font-poppins text-gray-400 text-xs uppercase tracking-widest mb-1">Email</p>
                    <p class="font-bebas text-gray-900 text-2xl leading-none group-hover:text-first transition break-all">facundo@gonzalezobras.com</p>
                </a>

                <div>
                    <p class="font-poppins text-gray-400 text-xs uppercase tracking-widest mb-1">Ubicación</p>
                    <p class="font-bebas text-gray-900 text-2xl leading-none">San Pedro, Buenos Aires</p>
                    <p class="font-poppins text-gray-400 text-xs mt-1 tracking-wide">CABA · Provincia · Rosario</p>
                </div>
            </div>

            <div class="md:px-12 flex flex-col gap-6 md:w-1/3">
                <p class="font-poppins text-gray-400 text-xs uppercase tracking-widest">Seguinos</p>

                <a href="https://instagram.com/gonzalez.obras" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4">
                    <div class="w-10 h-10 border border-gray-200 flex items-center justify-center shrink-0 group-hover:border-first transition">
                        <Instagram fill="#111111" stroke="#f9fafb" />
                    </div>
                    <div>
                        <p class="font-poppins text-gray-400 text-xs">Instagram</p>
                        <p class="font-bebas text-gray-900 text-xl leading-tight group-hover:text-first transition">@gonzalez.obras</p>
                    </div>
                </a>

                <a href="https://www.facebook.com/share/1DKUmMPAkA/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-4">
                    <div class="w-10 h-10 border border-gray-200 flex items-center justify-center shrink-0 group-hover:border-first transition">
                        <Facebook color="#111111" />
                    </div>
                    <div>
                        <p class="font-poppins text-gray-400 text-xs">Facebook</p>
                        <p class="font-bebas text-gray-900 text-xl leading-tight group-hover:text-first transition">Facundo Gonzalez</p>
                    </div>
                </a>
            </div>

            <div class="md:pl-12 flex flex-col gap-4 md:flex-1">
                <p class="font-poppins text-gray-400 text-xs uppercase tracking-widest">Dónde estamos</p>
                <div
                    id="map-placeholder"
                    data-src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d53808.77!2d-59.69!3d-33.685!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95b767a43d5d82ef%3A0x74b8e4b7f39a7b0!2sSan%20Pedro%2C%20Buenos%20Aires%2C%20Argentina!5e0!3m2!1ses!2sar!4v1"
                    style="width:100%;height:200px;background:#1a1a1a;"
                ></div>
                <script>
                    const placeholder = document.getElementById('map-placeholder');
                    if (placeholder) {
                        const observer = new IntersectionObserver((entries) => {
                            if (entries[0].isIntersecting) {
                                const iframe = document.createElement('iframe');
                                iframe.src = (placeholder as HTMLElement).dataset.src!;
                                iframe.width = '100%';
                                iframe.height = '200';
                                iframe.style.border = '0';
                                iframe.style.filter = 'grayscale(1) invert(0.85) contrast(0.9)';
                                iframe.allowFullscreen = true;
                                iframe.loading = 'lazy';
                                iframe.referrerPolicy = 'no-referrer-when-downgrade';
                                iframe.title = 'Ubicación de González Obras en San Pedro, Buenos Aires';
                                placeholder.replaceWith(iframe);
                                observer.disconnect();
                            }
                        }, { rootMargin: '200px' });
                        observer.observe(placeholder);
                    }
                </script>
            </div>

        </div>
    </div>

    <Footer />
</Layout>
