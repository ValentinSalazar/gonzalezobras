---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import TitleSection from '../TitleSection.astro';

import antes01 from '../../assets/transformaciones/antes01.webp';
import antes02 from '../../assets/transformaciones/antes02.webp';
import antes03 from '../../assets/transformaciones/antes03.webp';
import antes04 from '../../assets/transformaciones/antes04.webp';
import antes05 from '../../assets/transformaciones/antes05.webp';
import antes06 from '../../assets/transformaciones/antes06.webp';
import despues01 from '../../assets/transformaciones/despues01.webp';
import despues02 from '../../assets/transformaciones/despues02.webp';
import despues03 from '../../assets/transformaciones/despues03.webp';
import despues04 from '../../assets/transformaciones/despues04.webp';
import despues05 from '../../assets/transformaciones/despues05.webp';
import despues06 from '../../assets/transformaciones/despues06.webp';

interface Props {
    showTitle?: boolean;
    showAll?: boolean;
}

const { showTitle = true, showAll = false } = Astro.props;

const transformaciones: {
    number: string;
    title: string;
    category: string;
    before: ImageMetadata;
    after: ImageMetadata;
}[] = [
    { number: "01", title: "Cielorrasos y terminaciones", category: "Cielorrasos",         before: antes02, after: despues02 },
    { number: "02", title: "Revestimiento interior",      category: "Revestimientos",       before: antes01, after: despues01 },
    { number: "03", title: "Trabajo de Exterior",         category: "Reformas",             before: antes03, after: despues03 },
    { number: "04", title: "Construcción en seco",        category: "Construcción en Seco", before: antes04, after: despues04 },
    { number: "05", title: "Amoblamientos a medida",      category: "Amoblamientos",        before: antes05, after: despues05 },
    { number: "06", title: "Transformación completa",      category: "Reformas",             before: antes06, after: despues06 },
];

const INITIAL_COUNT = 3;
---

<section class="dot-grid pb-10 pt-2">

    {showTitle && (
        <TitleSection
            title="Transformaciones"
            color="first"
            subtitle="antes y después"
            new_clases="pl-5 md:pl-20 xl:pl-40 pb-5"
            title_size="text-5xl"
        />
    )}

    <div class={`px-5 md:px-20 xl:px-40 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5${showTitle ? ' pt-10' : ' pt-6'}`}>
        {transformaciones.map((t, i) => (
            <div class={`trans-card flex flex-col${!showAll && i >= INITIAL_COUNT ? ' hidden' : ''}`}>

                <button
                    class="img-container relative overflow-hidden bg-gray-200 h-80 sm:h-60 lg:h-[350px] w-full group cursor-zoom-in"
                    aria-label={`Ver ${t.title}`}
                >
                    <Image
                        src={t.before}
                        alt={`Antes - ${t.title} | González Obras`}
                        width={450}
                        class="img-antes absolute inset-0 w-full h-full object-cover transition-opacity duration-300"
                        loading={i < INITIAL_COUNT ? 'eager' : 'lazy'}
                    />
                    <Image
                        src={t.after}
                        alt={`Después - ${t.title} | González Obras`}
                        width={450}
                        class="img-despues absolute inset-0 w-full h-full object-cover transition-opacity duration-300 opacity-0"
                        loading="lazy"
                    />
                    <span class="absolute top-2.5 left-2.5 font-bebas text-white/80 text-xs tracking-widest bg-black/50 px-2 py-0.5">
                        {t.number}
                    </span>
                    <span class="state-label absolute top-2.5 right-2.5 font-bebas text-white text-xs tracking-widest bg-first px-2 py-0.5">
                        ANTES
                    </span>
                    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                        <svg class="opacity-0 group-hover:opacity-100 transition-opacity" width="36" height="36" viewBox="0 0 24 24" fill="none">
                            <circle cx="11" cy="11" r="7" stroke="white" stroke-width="2" />
                            <path d="M16.5 16.5L21 21" stroke="white" stroke-width="2" stroke-linecap="round" />
                            <path d="M11 8v6M8 11h6" stroke="white" stroke-width="2" stroke-linecap="round" />
                        </svg>
                    </div>
                </button>

                <!-- Tabs -->
                <div class="grid grid-cols-2 border border-gray-300 border-t-0">
                    <button class="btn-antes font-bebas text-sm py-2.5 tracking-widest transition-all duration-200 border-b-2 border-first text-first bg-white">
                        ANTES
                    </button>
                    <button class="btn-despues font-bebas text-sm py-2.5 tracking-widest transition-all duration-200 border-b-2 border-transparent text-gray-400 hover:text-gray-600 bg-white">
                        DESPUÉS
                    </button>
                </div>


            </div>
        ))}
    </div>

    {!showAll && transformaciones.length > INITIAL_COUNT && (
        <div class="flex justify-end mt-6 px-5 md:px-20 xl:px-40">
            <a
                href="/transformaciones"
                class="font-bebas text-secondary bg-first tracking-wider hover:bg-red-700 transition flex items-center gap-2 px-5 py-1.5 text-sm md:px-8 md:py-2.5 md:text-xl"
            >
                VER MÁS TRANSFORMACIONES
                <svg class="w-4 h-4 md:w-5 md:h-5" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </a>
        </div>
    )}

</section>

<!-- Lightbox -->
<div
    id="trans-lightbox"
    class="fixed inset-0 z-[100] bg-black/95 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
    aria-hidden="true"
>
    <button id="trans-lb-close" aria-label="Cerrar" class="absolute top-5 right-5 text-white/70 hover:text-white transition z-10">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
    </button>

    <div class="flex items-center gap-3 px-4">
        <button id="trans-lb-prev" aria-label="Anterior" class="shrink-0 text-white/60 hover:text-white transition">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M15 18L9 12L15 6"></path>
            </svg>
        </button>
        <div class="relative flex flex-col items-center gap-2">
            <img id="trans-lb-img" src="" alt="" class="max-w-[80vw] max-h-[80vh] object-contain" />
            <div class="flex items-center gap-3">
                <p id="trans-lb-label" class="font-bebas text-white tracking-widest text-sm bg-first px-3 py-0.5"></p>
                <p id="trans-lb-counter" class="font-poppins text-white/50 text-xs"></p>
            </div>
        </div>
        <button id="trans-lb-next" aria-label="Siguiente" class="shrink-0 text-white/60 hover:text-white transition">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <path d="M9 18L15 12L9 6"></path>
            </svg>
        </button>
    </div>
</div>

<script>
    function initTransformaciones() {
        document.querySelectorAll<HTMLElement>('.trans-card').forEach(card => {
            const btnAntes   = card.querySelector<HTMLButtonElement>('.btn-antes')!;
            const btnDespues = card.querySelector<HTMLButtonElement>('.btn-despues')!;
            const imgAntes   = card.querySelector<HTMLImageElement>('.img-antes')!;
            const imgDespues = card.querySelector<HTMLImageElement>('.img-despues')!;
            const label      = card.querySelector<HTMLElement>('.state-label')!;
            const imgBtn     = card.querySelector<HTMLButtonElement>('.img-container')!;

            function activate(active: HTMLButtonElement, inactive: HTMLButtonElement) {
                active.classList.add('border-first', 'text-first');
                active.classList.remove('border-transparent', 'text-gray-400');
                inactive.classList.remove('border-first', 'text-first');
                inactive.classList.add('border-transparent', 'text-gray-400');
            }

            btnAntes.addEventListener('click', () => {
                imgAntes.style.opacity = '1';
                imgDespues.style.opacity = '0';
                label.textContent = 'ANTES';
                activate(btnAntes, btnDespues);
            });

            btnDespues.addEventListener('click', () => {
                imgAntes.style.opacity = '0';
                imgDespues.style.opacity = '1';
                label.textContent = 'DESPUÉS';
                activate(btnDespues, btnAntes);
            });

            imgBtn.addEventListener('click', () => {
                const isAntes = imgDespues.style.opacity === '0' || imgDespues.style.opacity === '';
                openLightbox(imgAntes.src, imgDespues.src, isAntes ? 0 : 1);
            });
        });

        const lightbox  = document.getElementById('trans-lightbox')!;
        const lbImg     = document.getElementById('trans-lb-img') as HTMLImageElement;
        const lbClose   = document.getElementById('trans-lb-close')!;
        const lbPrev    = document.getElementById('trans-lb-prev')!;
        const lbNext    = document.getElementById('trans-lb-next')!;
        const lbLabel   = document.getElementById('trans-lb-label')!;
        const lbCounter = document.getElementById('trans-lb-counter')!;

        let srcs: string[] = [];
        let current = 0;

        function showItem() {
            lbImg.src = srcs[current];
            lbLabel.textContent = current === 0 ? 'ANTES' : 'DESPUÉS';
            lbCounter.textContent = `${current + 1} / ${srcs.length}`;
        }

        function openLightbox(srcAntes: string, srcDespues: string, startIndex: number) {
            srcs = [srcAntes, srcDespues];
            current = startIndex;
            showItem();
            lightbox.classList.remove('opacity-0', 'pointer-events-none');
            lightbox.setAttribute('aria-hidden', 'false');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            lightbox.classList.add('opacity-0', 'pointer-events-none');
            lightbox.setAttribute('aria-hidden', 'true');
            document.body.style.overflow = '';
        }

        lbClose.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

        lbPrev.addEventListener('click', () => {
            current = (current - 1 + srcs.length) % srcs.length;
            showItem();
        });
        lbNext.addEventListener('click', () => {
            current = (current + 1) % srcs.length;
            showItem();
        });

        document.addEventListener('keydown', (e) => {
            if (lightbox.getAttribute('aria-hidden') === 'true') return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') { current = (current - 1 + srcs.length) % srcs.length; showItem(); }
            if (e.key === 'ArrowRight') { current = (current + 1) % srcs.length; showItem(); }
        });
    }

    document.addEventListener('astro:page-load', initTransformaciones);
</script>

<style>
    .dot-grid {
        background-color: #f9fafb;
        background-image: radial-gradient(#d1d5db 1px, transparent 1px);
        background-size: 20px 20px;
    }
</style>
